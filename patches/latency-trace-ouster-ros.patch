--- /dev/null
+++ b/ouster-ros/src/latency_trace.h
@@ -0,0 +1,31 @@
+// Optional stage timestamps for latency analysis. Enabled with the environment variable BENCH_TRACE=1.
+// Lines are printed to stderr as "TRACE <what> key=value ..."; see benchmarks/pipeline/latency_trace.py.
+#pragma once
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+
+namespace bench_trace {
+
+inline bool enabled() {
+    static const bool e = std::getenv("BENCH_TRACE") != nullptr;
+    return e;
+}
+
+inline int64_t now_ns() {
+    return std::chrono::duration_cast<std::chrono::nanoseconds>(
+               std::chrono::system_clock::now().time_since_epoch())
+        .count();
+}
+
+// Stage times of the scan currently being processed. Written by the scan-processing thread only.
+struct Cur {
+    int64_t first_pkt = 0, complete = 0, dequeue = 0, built = 0, published = 0;
+};
+inline Cur& cur() {
+    static Cur c;
+    return c;
+}
+
+}  // namespace bench_trace
