@@ -0,0 +1,31 @@
+// Optional stage timestamps for latency analysis. Enabled with the environment variable BENCH_TRACE=1.
+// Lines are printed to stderr as "TRACE cam ..."; see benchmarks/pipeline/latency_trace.py.
+#pragma once
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+
+namespace bench_trace {
+
+inline bool enabled() {
+  static const bool e = std::getenv("BENCH_TRACE") != nullptr;
+  return e;
+}
+
+inline int64_t now_ns() {
+  return std::chrono::duration_cast<std::chrono::nanoseconds>(
+             std::chrono::system_clock::now().time_since_epoch())
+      .count();
+}
+
+// Stage times of the frame the calling camera thread is working on (one camera thread per node).
+struct CamCur {
+  int64_t retrieved = 0, copied = 0;
+};
+inline CamCur& cam() {
+  static thread_local CamCur c;
+  return c;
+}
+
+}  // namespace bench_trace
